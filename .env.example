NODE_ENV=development
HOST=127.0.0.1
PORT=3000
CORS_ORIGINS=http://localhost:5173

# Cổng phía máy chủ khi chạy Docker Compose. Cập nhật URL tương ứng khi đổi cổng.
# BACKEND_PORT=3000
# POSTGRES_PORT=5433
# MQTT_PORT=1884
# TEST_POSTGRES_PORT=5434
# TEST_MQTT_PORT=1885

POSTGRES_PASSWORD=replace-with-random-owner-password
POSTGRES_APP_PASSWORD=replace-with-random-app-password
DATABASE_URL=postgres://smartclass_app:replace-with-random-app-password@127.0.0.1:5433/smartclass
MIGRATION_DATABASE_URL=postgres://smartclass_owner:replace-with-random-owner-password@127.0.0.1:5433/smartclass
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-random-admin-password
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_EXPIRES_IN=3600
MQTT_URL=mqtt://127.0.0.1:1884
MQTT_USERNAME=backend_service
MQTT_PASSWORD=replace-with-random-backend-password
MQTT_CLIENT_ID=backend-01
MQTT_ADMIN_USERNAME=admin
MQTT_ADMIN_PASSWORD=replace-with-random-broker-admin-password
TEST_MQTT_ADMIN_PASSWORD=replace-with-random-test-broker-admin-password
DEVICE_SECRET_KEY=replace-with-64-hex-characters
TELEMETRY_FRESHNESS_S=30
HEARTBEAT_TIMEOUT_S=30
COMMAND_TIMEOUT_S=5
MANUAL_OVERRIDE_S=300
CONFIG_TIMEOUT_S=10
RETENTION_ENABLED=false
SENSOR_RETENTION_DAYS=90
EVENT_RETENTION_DAYS=7
SEED_DEMO_USERS=false
# Chỉ đặt DEMO_PASSWORD khi chủ động seed tài khoản demo trong môi trường thử nghiệm.
# DEMO_PASSWORD=replace-with-random-demo-password
# DEMO_ROOM_NAME=Phòng học demo
# BASE_URL=http://127.0.0.1:3000

# OTA Firmware. npm run setup:local tạo khóa Ed25519 riêng cho mỗi bản cài.
OTA_STORAGE_DIR=./storage/firmware
OTA_DOWNLOAD_BASE_URL=https://your-domain.example/api/v1
OTA_DOWNLOAD_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
OTA_MAX_FIRMWARE_BYTES=4194304
OTA_TIMEOUT_S=900
OTA_DOWNLOAD_URL_LIFETIME_S=300
OTA_SIGNING_PRIVATE_KEY_B64=replace-with-base64-encoded-ed25519-private-key
