NODE_ENV=development
HOST=127.0.0.1
PORT=3000
CORS_ORIGINS=http://localhost:5173
POSTGRES_PASSWORD=replace-with-random-owner-password
POSTGRES_APP_PASSWORD=replace-with-random-app-password
DATABASE_URL=postgres://smartclass_app:replace-with-random-app-password@127.0.0.1:5433/smartclass
MIGRATION_DATABASE_URL=postgres://smartclass_owner:replace-with-random-owner-password@127.0.0.1:5433/smartclass
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-random-admin-password
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_EXPIRES_IN=3600
MQTT_URL=mqtt://127.0.0.1:1884
MQTT_USERNAME=backend_service
MQTT_PASSWORD=replace-with-random-backend-password
MQTT_CLIENT_ID=backend-01
MQTT_ADMIN_USERNAME=admin
MQTT_ADMIN_PASSWORD=replace-with-random-broker-admin-password
TEST_MQTT_ADMIN_PASSWORD=replace-with-random-test-broker-admin-password
DEVICE_SECRET_KEY=replace-with-64-hex-characters
TELEMETRY_FRESHNESS_S=30
HEARTBEAT_TIMEOUT_S=30
COMMAND_TIMEOUT_S=5
MANUAL_OVERRIDE_S=300
CONFIG_TIMEOUT_S=10
SEED_DEMO_USERS=false
# Chỉ đặt DEMO_PASSWORD khi chủ động seed tài khoản demo trong môi trường thử nghiệm.
